# CCTV Monitoring System Configuration

# Database Configuration
CCTV_DB_SERVER=localhost
CCTV_DB_USER=sa
CCTV_DB_PASS=your_password
CCTV_DB_NAME=CCTV_Monitoring

# Server Configuration
PORT=3006
HTTPS_PORT=3007

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:3000

# Polling Configuration
POLL_INTERVAL=300
MAX_CONCURRENT_POLLS=10

# Alert Thresholds
STORAGE_WARNING_THRESHOLD=80
STORAGE_CRITICAL_THRESHOLD=95
OFFLINE_TIMEOUT_MINS=10

# Notification Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_DEFAULT_CHAT_ID=your_default_chat_id
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=noreply@cctv.com
EMAIL_PASSWORD=your_email_password